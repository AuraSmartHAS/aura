# AURA Care-Chain — variáveis de ambiente
# Copie para `.env` e preencha. O `.env` está no .gitignore.

# API do AURA (REST /api/v1) — a partir da Fase 5 é o backend-spring, na porta 8080.
# Em device físico use o IP da máquina; no emulador Android, 10.0.2.2 no lugar de localhost.
BACKEND_BASE_URL=http://localhost:8080

# Google Maps (rastreador de pedido). SEM esta chave o mapa abre sem os tiles —
# é obrigatória para a gravação da demo. Crie em console.cloud.google.com,
# habilite "Maps SDK for Android/iOS" e restrinja por aplicativo.
GOOGLE_MAPS_API_KEY=

# Supabase (apenas para o token do agente de voz ElevenLabs)
SUPABASE_URL=https://pcdezajyayljowwgrksr.supabase.co
SUPABASE_KEY=

# Firebase Cloud Messaging (push) — opcional em dev
FCM_VAPID_KEY=
