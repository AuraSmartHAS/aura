# AURA Care-Chain — variáveis de ambiente
# Copie para `.env` e preencha. O `.env` está no .gitignore.

# API do AURA (REST /api/v1) — a partir da Fase 5 é o backend-spring, na porta 8080.
# Em device físico use o IP da máquina; no emulador Android, 10.0.2.2 no lugar de localhost.
BACKEND_BASE_URL=http://localhost:8080

# Google Maps (rastreador de pedido): a chave NÃO fica aqui. Ela vai em
# `android/local.properties` (GOOGLE_MAPS_API_KEY=..., ignorado pelo git) ou na
# variável de ambiente GOOGLE_MAPS_API_KEY; modelo em `local.example.properties`.
# Sem ela o app compila, mas o mapa abre sem os tiles.

# Firebase Cloud Messaging (push) — opcional em dev
FCM_VAPID_KEY=

# SOS (C3) — telefone do contato principal da casa, usado quando o servidor diz
# que NÃO pode prometer o aviso (`canPromiseAlert: false`). A API de emergência
# devolve só o nome do contato, então o número vem daqui. Vazio: a tela do SOS
# oferece apenas o 192.
SOS_CONTACT_PHONE=

# Emergência pública. Botão que a pessoa toca — o app nunca disca sozinho.
SOS_EMERGENCY_PHONE=192

# Telefone do atendimento, citado na folha "Confirmar a compra" como o caminho
# para desistir de um pedido. É PÚBLICO (aparece na tela), não é segredo.
# Vazio: a folha não cita telefone nenhum — nunca um número de mentira.
SUPPORT_PHONE=
