# Variáveis do backend. Copie para .env (que está no .gitignore) e preencha.
# Nenhum valor real de segredo entra neste arquivo nem no repositório.

# --- Banco (perfil `postgres`, o do ensaio) ---
AURA_DB_URL=jdbc:postgresql://localhost:5432/aura
AURA_DB_USER=aura
# Obrigatória, sem default. A aplicação recusa subir sem ela.
AURA_DB_PASSWORD=

# Popula os dados de demonstração se o banco estiver vazio. Em banco persistente,
# a primeira subida popula e as seguintes preservam o que o ensaio criou.
AURA_SEED=false

# --- Rede local do ensaio ---
# 0.0.0.0 deixa os Androids alcançarem o notebook pelo IP dele. 127.0.0.1 fecha a porta.
AURA_BIND_ADDRESS=0.0.0.0
# Padrões de origem, não origens literais. Cobrem loopback e as faixas privadas usuais.
AURA_CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://192.168.*.*:*,http://10.*.*.*:*,http://172.16.*.*:*

# --- Autenticação ---
AURA_JWT_SECRET=

# --- Push (opcional) ---
# Vazias nas duas = push simulado. Uma das duas basta.
AURA_FIREBASE_CREDENTIALS=
AURA_FIREBASE_CREDENTIALS_JSON=
